{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate is scoped to the vertical-pod-autoscaler project only; the rest of the repository is handled by Dependabot.",
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "enabledManagers": [
    "gomod",
    "dockerfile"
  ],
  "includePaths": [
    "vertical-pod-autoscaler/**"
  ],
  "ignorePaths": [
    "**/vendor/**"
  ],
  "baseBranchPatterns": [
    "$default",
    "vpa-release-1.8",
    "vpa-release-1.7"
  ],
  "labels": [
    "area/vertical-pod-autoscaler",
    "kind/dependency",
    "triage/accepted",
    "release-note-none",
    "ok-to-test"
  ],
  "postUpdateOptions": [
    "gomodTidyAll"
  ],
  "packageRules": [
    {
      "description": "Go modules: also update indirect dependencies (Dependabot dependency-type: all).",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "master: group Kubernetes Go modules together.",
      "matchBaseBranches": ["$default"],
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "groupName": "go deps (kubernetes only)"
    },
    {
      "description": "master: group all other Go modules together.",
      "matchBaseBranches": ["$default"],
      "matchManagers": ["gomod"],
      "matchPackageNames": ["!k8s.io/**", "!sigs.k8s.io/**"],
      "groupName": "go deps"
    },
    {
      "description": "master: check Dockerfile base images daily and group non-major bumps.",
      "matchBaseBranches": ["$default"],
      "matchManagers": ["dockerfile"],
      "extends": ["schedule:daily"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docker images"
    },
    {
      "description": "Release branches: no major or minor updates by default.",
      "matchBaseBranches": ["/^vpa-release-/"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Release branches: pre-1.0 Go modules (golang.org/x/*, etc.) treat minor bumps as patch-level, so allow them; Kubernetes modules stay patch-only.",
      "matchBaseBranches": ["/^vpa-release-/"],
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "matchPackageNames": ["!k8s.io/**", "!sigs.k8s.io/**"],
      "enabled": true
    },
    {
      "description": "Release branches: everything that is still enabled goes into a single PR.",
      "matchBaseBranches": ["/^vpa-release-/"],
      "groupName": "release-branch updates"
    }
  ]
}
